{
  "info": {
    "name": "To-Do List API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://nama-project.vercel.app"
    }
  ],
  "item": [
    {
      "name": "Tugas (Tasks)",
      "item": [
        {
          "name": "POST Tambah Tugas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "Menambahkan tugas baru (tambahTugas). tag_ids opsional.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"category_id\": 1,\n  \"title\": \"Kerjakan tugas akhir backend\",\n  \"description\": \"Buat REST API dan deploy ke Vercel\",\n  \"due_date\": \"2026-11-01\",\n  \"priority\": \"tinggi\",\n  \"tag_ids\": [\n    1\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET Daftar Tugas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "Mengambil semua tugas (getDataTugas). Filter opsional lewat query: user_id, category_id, is_done (true/false), priority (rendah/sedang/tinggi), tag_id, search. Contoh: /tasks?user_id=1&is_done=false"
          }
        },
        {
          "name": "GET Detail Tugas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "1"
              ]
            },
            "description": "Mengambil satu tugas berdasarkan ID (getTugasById), lengkap dengan nama kategori dan tag."
          }
        },
        {
          "name": "PUT Ubah Tugas (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "1"
              ]
            },
            "description": "Mengubah seluruh data tugas (ubahTugas). title wajib; field lain yang tidak dikirim akan dikosongkan. Jika tag_ids dikirim, tag lama diganti.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Kerjakan tugas akhir (revisi)\",\n  \"description\": \"Tambah dokumentasi\",\n  \"due_date\": \"2026-11-02\",\n  \"priority\": \"sedang\",\n  \"category_id\": 1,\n  \"tag_ids\": [\n    1,\n    2\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PATCH Ubah Sebagian Tugas (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "1"
              ]
            },
            "description": "Mengubah sebagian data tugas; kirim hanya field yang ingin diubah.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"rendah\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PATCH Tandai Tugas Selesai",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/1/done",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "1",
                "done"
              ]
            },
            "description": "Menandai tugas selesai (tandaiTugasSelesai): is_done menjadi true dan completed_at terisi. Tanpa request body."
          }
        },
        {
          "name": "DELETE Hapus Tugas",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "1"
              ]
            },
            "description": "Menghapus tugas berdasarkan ID (hapusTugas)."
          }
        }
      ]
    },
    {
