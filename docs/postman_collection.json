                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "1"
              ]
            },
            "description": "Menghapus user beserta profil, kategori, dan tugasnya (ON DELETE CASCADE)."
          }
        },
        {
          "name": "GET Lihat Profil User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/1/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "1",
                "profile"
              ]
            },
            "description": "Mengambil profil user (relasi 1:1)."
          }
        },
        {
          "name": "PUT Simpan Profil User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/1/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "1",
                "profile"
              ]
            },
            "description": "Membuat profil jika belum ada, atau mengubahnya jika sudah ada.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Aulia Dwiyanti Nur Azizah\",\n  \"phone\": \"081234567890\",\n  \"bio\": \"Mahasiswa backend\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
